NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=scholarshop

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-16-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-string-at-least-16-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email — set MAIL_DEV=true for local dev (OTP in console + `otp` field in register JSON). No SMTP required.
MAIL_DEV=true
# Extra verify-step logging (expires_at vs NOW); set true only while debugging
DEBUG_OTP=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ScholarShop <no-reply@localhost>
# Max OTP emails per user per rolling hour
OTP_RESEND_LIMIT=5

# University domains only (comma-separated), e.g. uohyd.ac.in,example.edu
ALLOWED_EMAIL_DOMAINS=uohyd.ac.in,example.edu,test.ac.in,demo.edu.in

# Uploads
UPLOAD_DIR=uploads

# Auto-hide threshold for reports
REPORT_HIDE_THRESHOLD=5
